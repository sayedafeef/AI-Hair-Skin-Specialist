GROQ_API_KEY=your_groq_api_key_here
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_TTS_MODEL=aura-2-thalia-en
WHISPER_MODEL=whisper-large-v3
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_ROUTER_MODEL=openai/gpt-oss-20b
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_generated_random_hex_string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Defaults to a local SQLite file (backend/app.db) if not set.
# For Postgres: postgresql://user:password@localhost:5432/dbname
DATABASE_URL=
